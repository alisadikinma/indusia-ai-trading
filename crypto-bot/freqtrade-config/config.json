    "model_training_parameters": {
      "n_estimators": 200,
      "max_depth": 6,
      "learning_rate": 0.05,
      "verbosity": 0,
      "n_jobs": -1
    }
  },
  "freqaimodel": "ClaudeOversightModel",
  "freqaimodel_path": "crypto-bot/freqtrade-config/freqaimodels"

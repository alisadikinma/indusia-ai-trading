[Unit]
Description=AI Trading 24/7 — live Binance WS kline ingest into brain.ohlcv
Documentation=file:///opt/ai-trading/docs/plans/2026-05-06-ai-trading-247.md
After=docker.service network-online.target postgres-init.service
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/ai-trading
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/ai-trading/.env
ExecStart=/opt/ai-trading/.venv/bin/python -m infra.data_loader.live_ws_ingest \
    --symbol btcusdt --tf 1m
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
MemoryMax=256M

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=AI Trading 24/7 — FreqAI retrain health check (Phase 6)
Documentation=file:///opt/ai-trading/docs/plans/2026-05-06-ai-trading-247.md
After=network-online.target postgres-init.service
Wants=network-online.target

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/ai-trading
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/ai-trading/.env
ExecStart=/opt/ai-trading/.venv/bin/python -m infra.scripts.retrain_health_check
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# AI Trading 24/7 — environment template
# Copy to repo-root .env (gitignored) and fill in real values.
# NEVER commit a populated .env. Real production values live on the VPS only.

# -- Postgres ---------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
# Host port (used by clients on this machine). On VPS use 5432 directly.
# On Windows dev boxes Hyper-V often reserves 5432 — use 5544 instead.
POSTGRES_PORT=5432
# Docker compose host-side port mapping. Override on Windows: POSTGRES_HOST_PORT=5544
POSTGRES_HOST_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=

# -- Telegram bot (Phase 1) -------------------------------------------------
# How to get these:
#   1. Open Telegram, message @BotFather, run /newbot
#   2. Save the API token here
#   3. Send any message to your new bot from your operator account
#   4. curl https://api.telegram.org/bot<TOKEN>/getUpdates → grab message.from.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_USER_ID=
# HMAC secret for kill-switch /halt command (Phase 11). Use: openssl rand -hex 32
TELEGRAM_HMAC_SECRET=

# -- Phase 2: data ingestion -----------------------------------------------
# On-disk cache for downloaded Binance Vision monthly zips. Deletable; loader
# re-downloads on demand and re-verifies SHA256.
BINANCE_VISION_CACHE_DIR=infra/data_loader/.cache/binance_vision

# -- Anthropic API (Phase 5+, used by Claude Code Routine cron in non-interactive mode) -
ANTHROPIC_API_KEY=

# -- PULSE bridge (Phase 4) -------------------------------------------------
# HMAC secret for Claude→bridge auth. Use: openssl rand -hex 32
PULSE_HMAC_SECRET=

# -- Dashboard UI auth (Phase 1.5) ------------------------------------------
# JWT signing secret. Use: openssl rand -hex 64
DASHBOARD_JWT_SECRET=
# Operator credentials (single-user setup). Hash via argon2id at first run.
DASHBOARD_OPERATOR_USERNAME=
DASHBOARD_OPERATOR_PASSWORD_ARGON2_HASH=

# -- Exchange API keys (Phase 12 — DO NOT FILL IN UNTIL READY FOR LIVE) ------
# Trade-only permissions (no withdraw). IP-allowlist VPS public IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BLOFIN_API_KEY=
BLOFIN_API_SECRET=

# -- Tailscale (configured on VPS, not via .env) ----------------------------
# Run on VPS: tailscale up --authkey=<auth-key-from-tailscale-admin>
# Auth keys live in https://login.tailscale.com/admin/settings/keys

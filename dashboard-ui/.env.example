# Bot Cockpit UI — operator credentials and session signing.
# All variables are REQUIRED at runtime. The server refuses to start without
# them (see src/lib/auth.ts — there are NO silent defaults).
#
# Generate a fresh argon2id hash for the operator password:
#   cd dashboard-ui
#   node -e "require('./src/lib/password').hashPassword('YOUR_PASSWORD').then(console.log)"
#
# Generate a JWT secret (>= 32 bytes, base64):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"

DASHBOARD_OPERATOR_USERNAME=
DASHBOARD_OPERATOR_PASSWORD_ARGON2_HASH=
DASHBOARD_JWT_SECRET=

# -- Dashboard read-only API (Phase 1.5.B + 1.5.C) --------------------------
# Public URL of the pulse-bridge dashboard API. Inlined into the client
# bundle — must be set at build/dev start. Hard-fails on missing.
NEXT_PUBLIC_DASHBOARD_API_URL=http://127.0.0.1:8081
# WebSocket URL for live pg_notify fan-out (channels: dashboard_signals,
# dashboard_journal, dashboard_equity). Hard-fails on missing.
NEXT_PUBLIC_DASHBOARD_WS_URL=ws://127.0.0.1:8081/dashboard/ws
